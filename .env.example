# Copy to .env and fill in. Vite only exposes VITE_-prefixed vars to the client,
# so nothing here may be a secret — these are all public, build-time values.

# Formspree form ID for the contact form (https://formspree.io → your form → the
# ID in the endpoint URL). Without it the form reports "Error Sending".
VITE_FORMSPREE_ID=

# Path (or URL) the hero's "Download Resume" button points at.
# Defaults to /resume-2026.pdf when unset.
VITE_RESUME_URL=/resume-2026.pdf
